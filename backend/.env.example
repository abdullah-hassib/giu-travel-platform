# Copy to .env and replace with your real Atlas connection string (never commit .env)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
PORT=3000
NODE_ENV=development

# PROVISIONAL defaults pending official Excel acceptance criteria
SESSION_TTL_HOURS=24
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# Admin seeding: pass these securely as one-time process env vars, not via Git
# ADMIN_BOOTSTRAP_EMAIL=
# ADMIN_BOOTSTRAP_PASSWORD=

# Optional FXRatesAPI key for authenticated quota. Public daily access works without one.
# FXRATES_API_KEY=

# Private Stripe test configuration. Set values locally when ready.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Folder for uploaded JPG/PNG images (GEN-08). Defaults to ./uploads.
# MEDIA_UPLOAD_DIR=uploads
