# Copy to .env and replace with your real Atlas connection string (never commit .env)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
PORT=3000
NODE_ENV=development

# PROVISIONAL defaults pending official Excel acceptance criteria
SESSION_TTL_HOURS=24
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# Admin seeding: pass these securely as one-time process env vars, not via Git
# ADMIN_BOOTSTRAP_EMAIL=
# ADMIN_BOOTSTRAP_PASSWORD=
